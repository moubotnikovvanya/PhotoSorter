<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.photosorter.fragments.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_imagesGridFragment"
            app:destination="@id/imagesGridFragment" />
        <action
            android:id="@+id/action_homeFragment_to_editButtonsFragment"
            app:destination="@id/editButtonsFragment" />
    </fragment>
    <fragment
        android:id="@+id/imagesGridFragment"
        android:name="com.example.photosorter.fragments.ImagesGridFragment"
        android:label="fragment_images_grid"
        tools:layout="@layout/fragment_images_grid" >
        <action
            android:id="@+id/action_imagesGridFragment_to_imageShowcaseFragment"
            app:destination="@id/imageShowcaseFragment" />
    </fragment>
    <fragment
        android:id="@+id/imageShowcaseFragment"
        android:name="com.example.photosorter.fragments.ImageShowcaseFragment"
        android:label="ImageShowcaseFragment" />
    <fragment
        android:id="@+id/editButtonsFragment"
        android:name="com.example.photosorter.fragments.EditButtonsFragment"
        android:label="EditButtonsFragment" />
</navigation>